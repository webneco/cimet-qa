# CIMET QA Gate - copy this to `.env` and fill in what you need.
#
# Every value is optional. With no .env file at all the app still runs end to
# end: Type A is deterministic anyway, and Type B falls back to the built-in
# deterministic extractor (the UI says so on screen, and every result records
# which extractor produced it).

# --------------------------------------------------------------- LLM access
# Used only for Type B extraction: reading the spoken value out of the
# transcript. The key is read from this file and never leaves the process.
# It is not logged, not written into run artifacts, and not sent anywhere
# except api.anthropic.com.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# auto = use the LLM when a key is present (default)
# on   = insist on the LLM
# off  = force the deterministic extractor
CIMET_LLM=auto
CIMET_MODEL=claude-opus-5
CIMET_LLM_EFFORT=medium
CIMET_LLM_TIMEOUT=60

# --------------------------------------------------------------------- gate
# A critical check scoring below this confidence routes to QA instead of
# being trusted either way.
CIMET_CONFIDENCE_FLOOR=0.6

# Share of SUBMITTED runs flagged for post-submit audit.
# Set to 1.0 to see the SAMPLE AUDIT badge on lead 3613791.
CIMET_SAMPLE_AUDIT_RATE=0.05
CIMET_SAMPLE_SALT=cimet-qa-gate-2026

# ---------------------------------------------------------------------- app
CIMET_PORT=8787
CIMET_HOST=127.0.0.1
CIMET_PRELOAD_LEAD=3613790
CIMET_OPEN_BROWSER=1

# Install the anthropic SDK automatically on first run when a key is present.
CIMET_AUTO_INSTALL=1
